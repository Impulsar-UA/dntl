# Base URL of the Donatly ASP.NET API.
# Default for local development (see backend/DonatlyAPI/Properties/launchSettings.json).
VITE_API_BASE_URL=http://localhost:5029/api

# Google OAuth Client ID for "Sign in with Google" (optional, free).
# Get one at https://console.cloud.google.com/apis/credentials
# (Create credentials -> OAuth client ID -> Web application;
#  add http://localhost:5173 to Authorized JavaScript origins).
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
